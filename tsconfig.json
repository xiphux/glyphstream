{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	// The same program SvelteKit 2's generated config defined, which SvelteKit 3
	// leaves to us. `tests/**/*.js`, not `tests`: the .mjs fixtures (the mock
	// upstream, the image smoke runner) are plain Node scripts that were never
	// type-checked, and `$app/tsconfig` turns on checkJs. The other root
	// *.config.ts files belong to ESLint's allowDefaultProject (eslint.config.js),
	// and a file may not be in both.
	"include": [
		"src",
		"tests/**/*.ts",
		"tests/**/*.js",
		"tests/**/*.svelte",
		"vite.config.ts",
		"sveltekit.config.ts"
	],
	// The service worker runs with worker globals, not DOM ones; ESLint lints it
	// under its own default project. Both entries: Kit's tsconfig validation asks
	// for the directory form, and only the file form excludes our single file.
	"exclude": ["src/service-worker", "src/service-worker.ts"]
}
