{
	// Renovate keeps the dependencies here current. It replaced Dependabot's
	// version updates, which is why .github/dependabot.yml is gone: two updaters
	// proposing the same bumps would be ambiguous at best. Dependabot's SECURITY
	// updates stay on -- a repository setting, not this file -- so vulnerable
	// packages still arrive as dependabot/** PRs, and ci.yml still ignores that
	// branch prefix on its push trigger for them.
	//
	// What Renovate does that Dependabot could not:
	//   - Raises a major and a minor of the same package at once. Dependabot
	//     offers only the newest version, so a pending major replaced that
	//     package's routine updates -- hence majors were ignored there and an
	//     issue was opened per major instead.
	//   - Rebases a pull request that has fallen behind main, not only one that
	//     conflicts. That is what stalled batches under Dependabot: each merge
	//     left the rest behind, and only a human comment moved them.
	//
	// The one workaround it needs is .github/workflows/renovate-nudge.yml: on
	// this plan jobs run every four hours, and a merge Renovate performs itself
	// enqueues no job, so nothing would rebase the PRs that merge left behind.
	//
	// To go back: `git log -- .github/dependabot.yml` has the last version, with
	// dependabot-automerge.yml and upgrade-check.yml in the history beside it.
	// The TypeScript-release issue that workflow also opened went with it: the
	// npm aliases it watched are temporary, until TypeScript 7.1 makes keeping
	// both compilers unnecessary. Until then nothing notices a TypeScript
	// release, since Renovate and `pnpm outdated` both skip aliases.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: ['config:recommended'],

	// Rebase whenever a branch falls behind main, not only when it conflicts.
	// This is the setting the switch from Dependabot was made for, so it is
	// spelled out rather than pulled in as the `:rebaseStalePrs` preset, which
	// expands to exactly this and hides it in a list.
	rebaseWhen: 'behind-base-branch',

	// Matches the Dependabot cooldown this repo already ran: a week, not a day.
	// pnpm 11 refuses packages younger than 24h and checks the LOCKFILE against
	// it, so a same-day release fails `--frozen-lockfile` in CI — but the longer
	// wait is for supply-chain reasons: most malicious publishes are found and
	// yanked within days.
	minimumReleaseAge: '7 days',

	// One issue listing every pending update, majors included. It stands in for
	// the weekly major-upgrade issues the old upgrade-check.yml opened, though
	// the majors now arrive as pull requests in their own right.
	dependencyDashboard: true,
	dependencyDashboardTitle: 'Dependency dashboard',

	// Deliberately small. Actions minutes are free on a public repository, so
	// unlike the private repos this is not a billing decision: it bounds how
	// many open PRs a single merge invalidates, since `rebaseWhen:
	// 'behind-base-branch'` rebases every one left behind and each rebase
	// re-runs CI. Kept in line with the private repositories, where the same
	// number is a direct saving, so the configs stay comparable. Majors are
	// what to watch, since one nobody merges holds its slot indefinitely.
	prConcurrentLimit: 6,
	// The one number deliberately out of line with the other seven repos, which
	// leave this at the default of 2. Creation rate is throttled there to keep
	// CI minutes down; that reason does not apply to a public repository, so
	// this one drains faster at no cost. Drop it to the default if this ever
	// goes private.
	prHourlyLimit: 4,

	// Merge commits, as the auto-merge workflow made them, so history reads the
	// same across the trial boundary.
	automergeStrategy: 'merge',
	// GitHub's own auto-merge, which lands a PR the instant its checks pass.
	// Turning it off was tested and changed nothing useful: the blocker was
	// never who merges, it was that nothing wakes Renovate afterwards. A job
	// can rebase a branch OR merge one, not both -- the CI it triggers outlives
	// the job -- and a merge it performs itself does not enqueue another job
	// (#58, #56 and #57 all merged without one following). Waiting for
	// Renovate to merge therefore cost immediacy and bought nothing.
	//
	// What actually removes the problem is the grouping below: one PR at a time
	// means no second PR left behind by a merge, so the 4-hour scheduled
	// cadence stops mattering.
	platformAutomerge: true,

	// `deps:`/`deps(dev):` for npm and `ci:` for actions, as Dependabot was
	// configured to write, so the commit history stays consistent.
	commitMessagePrefix: 'deps:',

	// `dependencies` is what .github/release.yml filters on to keep dependency
	// bumps out of the user-facing release notes. Dependabot applied it by
	// default; Renovate applies no labels unless told, so its PRs were about to
	// start appearing in the notes.
	labels: ['dependencies'],

	packageRules: [
		{
			matchManagers: ['github-actions'],
			commitMessagePrefix: 'ci:',
			// A hijacked action tag is usually caught and pulled within days; a week
			// keeps a fresh compromise from reaching a SHA pin automatically.
			minimumReleaseAge: '7 days',
		},
		{
			matchManagers: ['npm'],
			matchDepTypes: ['devDependencies'],
			commitMessagePrefix: 'deps(dev):',
		},

		// What auto-merges, and what does not. Carried over unchanged from the
		// hand-written auto-merge workflow this replaced: patch yes; minor yes
		// unless the package is 0.x, where a minor is the breaking release;
		// majors and prereleases never.
		{
			// A 0.0.x patch rides along with the rest. Semver promises nothing
			// there -- any release may break -- but CI is the gate that matters
			// here, and it covers those packages like any other. Hold one by name
			// if that ever stops being true.
			matchUpdateTypes: ['patch', 'minor'],
			automerge: true,
		},
		{
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^0\\./',
			automerge: false,
		},
		{
			// The 0.x packages whose minors CI can actually judge, carried over from
			// ZERO_X_MINOR_OK: each is exercised by the suite rather than merely
			// installed by it.
			matchPackageNames: ['sharp', 'esbuild', 'linkedom', '@mozilla/readability'],
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^0\\./',
			automerge: true,
		},
		{
			// Majors arrive as their own pull requests now, which is the second
			// reason for the trial: Dependabot offers only a package's newest
			// version, so an un-ignored major REPLACED that package's minor and
			// patch updates. Renovate raises both, so a pending major no longer
			// costs the routine updates. They are never auto-merged.
			matchUpdateTypes: ['major'],
			automerge: false,
		},
		{
			// Prereleases were held by the old workflow and stay held. Renovate does
			// not propose them by default; this makes that explicit rather than
			// relying on the default not to change.
			matchCurrentVersion: '/-/',
			automerge: false,
		},

		// Packages that must move together, so CI never sees half a family bumped.
		// Narrow on purpose, and NOT a catch-all: grouping every routine update
		// into one PR would remove the contention between PRs, but it makes one
		// failing update hold every other update in the batch -- for as long as
		// that one takes to fix. Separate PRs keep a stuck update stuck by itself.
		// The contention is handled by .github/workflows/renovate-nudge.yml
		// instead, which wakes Renovate after each merge so it rebases the rest.
		{
			groupName: 'svelte',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: [
				'svelte',
				'svelte-check',
				'svelte-eslint-parser',
				'eslint-plugin-svelte',
				'prettier-plugin-svelte',
				'@sveltejs/**',
				'@testing-library/svelte',
			],
		},
		{
			groupName: 'vite',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: [
				'vite',
				'vitest',
				'@vitest/**',
				'tailwindcss',
				'@tailwindcss/**',
				'@vite-pwa/**',
				'workbox-**',
			],
		},
		{
			groupName: 'lint',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: [
				'eslint',
				'@eslint/**',
				'eslint-**',
				'typescript-eslint',
				'@stylistic/**',
				'globals',
				'prettier',
			],
		},
		{
			groupName: 'shiki',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: ['shiki', '@shikijs/**'],
		},
		{
			groupName: 'simplewebauthn',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: ['@simplewebauthn/**'],
		},

		{
			// drizzle is upgraded by hand. It is pinned to an exact 1.0.0 RC, and
			// drizzle also publishes snapshot builds of internal branches to npm
			// (`1.0.0-rc.5-169397b`, dist-tags like `effect-fixes`). Semver ranks
			// those above the official RC, so Dependabot proposed one (#25), and
			// that build broke the relations API, blob decoding and error messages.
			// Follow the `rc` dist-tag / GitHub releases instead. Revisit once 1.0.0
			// ships stable.
			matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
			enabled: false,
		},
	],

	// Renovate raises a pull request for a vulnerable package regardless of the
	// cooldown above, the same carve-out Dependabot's security updates have.
	vulnerabilityAlerts: {
		minimumReleaseAge: null,
		automerge: false,
	},
}
