{
	// Renovate keeps the dependencies here current, and raises the security
	// fixes too; Dependabot's own security pull requests are switched off in
	// the repository settings, and its ALERTS stay on.
	//
	// Almost everything comes from the shared preset, xiphux/renovate-config:
	// the cooldowns, the auto-merge policy, the weekly timetable and its
	// groups, lockfile maintenance and the vulnerability alerts, each with its
	// rationale beside it. What follows is only what differs here. This file's
	// packageRules are appended after the preset's, and later rules win.
	//
	// To go back to Dependabot: `git log -- .github/dependabot.yml` has the
	// last version, with dependabot-automerge.yml and upgrade-check.yml in the
	// history beside it. The TypeScript-release issue that workflow also
	// opened went with it: the npm aliases it watched are temporary, until
	// TypeScript 7.1 makes keeping both compilers unnecessary. Until then
	// nothing notices a TypeScript release, since Renovate and `pnpm outdated`
	// both skip aliases.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: ['github>xiphux/renovate-config:default.json5'],

	dependencyDashboardTitle: 'Dependency dashboard',

	// Deliberately small. Actions minutes are free on a public repository, so
	// unlike the private repos this is not a billing decision: it bounds how
	// many open PRs a single merge invalidates, since `rebaseWhen:
	// 'behind-base-branch'` rebases every one left behind and each rebase
	// re-runs CI. Kept in line with the private repositories, where the same
	// number is a direct saving, so the configs stay comparable. Majors are
	// what to watch, since one nobody merges holds its slot indefinitely.
	prConcurrentLimit: 6,

	// `deps:`/`deps(dev):` for npm and the preset's `ci:` for actions, as
	// Dependabot was configured to write, so the commit history stays
	// consistent.
	commitMessagePrefix: 'deps:',

	packageRules: [
		{
			matchManagers: ['npm'],
			matchDepTypes: ['devDependencies'],
			commitMessagePrefix: 'deps(dev):',
		},
		{
			// The Dockerfile's base image is pinned by digest, so a tag that gets
			// re-pushed (or hijacked) can't change what a release builds from.
			// Renovate keeps the pin current: a rebuilt node:26-alpine arrives as a
			// digest update, and it auto-merges like a patch, since the image smoke
			// test in CI boots the result. Scoped to the Dockerfile, because the
			// compose file names a locally built image there is nothing to pin for.
			matchManagers: ['dockerfile'],
			pinDigests: true,
		},
		{
			// This must come after the preset's "prereleases never auto-merge"
			// rule (`matchCurrentVersion: '/-/'`), and being in this file it does.
			// Renovate tests that pattern against the version string, so it
			// matches the `26-alpine` tag too, and whichever rule comes later
			// wins: before the move to the preset this one came first, and the
			// digest updates it describes did not auto-merge.
			matchManagers: ['dockerfile'],
			matchUpdateTypes: ['digest'],
			automerge: true,
		},
		{
			// The 0.x packages whose minors CI can actually judge, carried over from
			// ZERO_X_MINOR_OK: each is exercised by the suite rather than merely
			// installed by it. The pattern leaves out prereleases: this rule comes
			// after the preset's prerelease rule, and `/^v?0\\./` alone would
			// re-enable auto-merge for a 0.x prerelease.
			matchPackageNames: ['sharp', 'esbuild', 'linkedom', '@mozilla/readability'],
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^v?0\\.[^-]*$/',
			automerge: true,
		},

		// Additions to the preset's groups. Later rules win, so these take
		// packages out of the groups that would otherwise claim them.
		//
		// "Test and build" is broader here than its name: by this repository's
		// convention (CLAUDE.md), everything bundled into build/ is a
		// devDependency, so svelte, kit, web-push and the MCP SDK update on
		// Thursday too. `dependencies` holds only what cannot be bundled.
		{
			// The svelte family moves as one, as its own group did: the compiler,
			// kit and svelte-check, and the plugins that parse svelte syntax for
			// eslint and prettier -- which the preset's lint list would otherwise
			// take to Wednesday, a day apart from the compiler they have to
			// understand.
			groupName: 'test and build',
			matchPackageNames: [
				'svelte',
				'svelte-check',
				'svelte-eslint-parser',
				'eslint-plugin-svelte',
				'prettier-plugin-svelte',
				'@sveltejs/**',
				'@testing-library/svelte',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 4'],
		},
		{
			// The one exception to "majors are never grouped": kit and its adapters
			// release majors in lockstep, each new adapter major requiring the new
			// kit major (adapter-node 6 needs kit 3). Apart, neither pull request can
			// pass CI -- #112 and #113 were exactly that -- so they come as one, and
			// the migration lands as further commits on its branch before it is
			// merged by hand. vite-plugin-svelte is here because kit pins its major
			// as a peer. Kept to these names rather than `@sveltejs/**`, which would
			// drag @sveltejs/eslint-config's unrelated majors into a framework
			// migration. Inherits the preset's major rule: no auto-merge, rebased
			// only on conflict.
			groupName: 'sveltekit',
			matchPackageNames: ['@sveltejs/kit', '@sveltejs/adapter-*', '@sveltejs/vite-plugin-svelte'],
			matchUpdateTypes: ['major'],
		},
		{
			// With shiki and its other @shikijs packages, which are production
			// dependencies (shiki ships unbundled); only the types are a
			// devDependency.
			groupName: 'production dependencies',
			matchPackageNames: ['@shikijs/types'],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 5'],
		},

		{
			// drizzle is upgraded by hand. It is pinned to an exact 1.0.0 RC, and
			// drizzle also publishes snapshot builds of internal branches to npm
			// (`1.0.0-rc.5-169397b`, dist-tags like `effect-fixes`). Semver ranks
			// those above the official RC, so Dependabot proposed one (#25), and
			// that build broke the relations API, blob decoding and error messages.
			// Follow the `rc` dist-tag / GitHub releases instead. Revisit once 1.0.0
			// ships stable.
			matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
			enabled: false,
		},
	],
}
