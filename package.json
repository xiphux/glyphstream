{
	"name": "glyphstream",
	"private": true,
	"version": "0.34.3",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "pnpm build:worker && vite dev",
		"build": "pnpm build:worker && vite build && pnpm exec esbuild scripts/import-owui.ts --bundle --platform=node --target=node26 --format=esm --packages=external --outfile=build/scripts/import-owui.js && cp src/lib/server/code-interpreter/worker.js build/server/chunks/worker.js",
		"build:worker": "pnpm exec esbuild src/lib/server/code-interpreter/worker.ts --bundle --platform=node --target=node26 --format=esm --external:pyodide --outfile=src/lib/server/code-interpreter/worker.js",
		"analyze": "ANALYZE=1 vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' ; husky || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && eslint .",
		"lint:fix": "svelte-kit sync && eslint . --fix && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"eval": "vitest run --config vitest.eval.config.ts",
		"import:owui": "tsx scripts/import-owui.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md}": "prettier --write"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@mozilla/readability": "^0.6.0",
		"@shikijs/langs": "^4.4.2",
		"@shikijs/themes": "^4.4.2",
		"@shikijs/types": "^4.4.2",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"drizzle-orm": "1.0.0-rc.3",
		"eventsource-parser": "^3.1.0",
		"linkedom": "^0.18.13",
		"markdown-it": "^15.0.0",
		"pyodide": "^314.0.3",
		"sharp": "^0.35.3",
		"shiki": "^4.4.2",
		"smol-toml": "^1.7.1",
		"web-push": "^3.6.7",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.30.0",
		"@playwright/test": "^1.62.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/eslint-config": "^10.0.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.2.0",
		"@types/web-push": "^3.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/ui": "^4.1.10",
		"bits-ui": "^2.18.1",
		"drizzle-kit": "1.0.0-rc.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"happy-dom": "^20.11.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.11",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-window": "^7.4.1"
	}
}
